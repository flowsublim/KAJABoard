# KAJABoard reads environment variables from the host process.
# Load this file through your shell/hosting environment; it is not read automatically.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Local development defaults to SQLite when DJANGO_DB_ENGINE is omitted.
# Production must use postgresql and provide every required database value.
DJANGO_DB_ENGINE=sqlite
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=5432
DJANGO_DB_SSLMODE=
DJANGO_DB_CONN_MAX_AGE=60

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
